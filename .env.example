# Preferred Garage Admin-specific Postgres connection. Falls back to DATABASE_URL if unset.
GARAGE_ADMIN_DATABASE_URL=postgresql://aibry:REPLACE_ME@fedora.local:5432/taskmaster
GARAGE_ADMIN_DATABASE_HOST=fedora.local
GARAGE_ADMIN_DATABASE_PORT=5432

# Backward-compatible fallback names.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=

ADMIN_BRIDGE_BASE_URL=http://fedora.local:4000
FEDORA_ADMIN_PROXY_URL=http://fedora.local:4000
FEDORA_GARAGE_API_URL=http://fedora.local:5000
FEDORA_GARAGE_API_KEY=REPLACE_ME
ADMIN_BRIDGE_TOKEN=REPLACE_ME
WINDOWS_ADMIN_BASE_URL=
WINDOWS_ADMIN_AUTH_TOKEN=
WINDOWS_GARAGE_BASE_URL=
WINDOWS_GARAGE_API_KEY=
WINDOWS_BRIDGE_TIMEOUT_MS=7000
ADMIN_BRIDGE_TIMEOUT_MS=10000
ADMIN_BRIDGE_ACTION_TIMEOUT_MS=30000
WINDOWS_EXECUTOR_TIMEOUT_MS=30000
WINDOWS_VERIFICATION_TIMEOUT_MS=5000

# Experimental ChatKit prep surface. Keep OPENAI_API_KEY server-side only.
# Hosted ChatKit sessions are created on the backend. The frontend receives only
# a short-lived client secret and uses a temporary local operator identifier until
# a durable authenticated operator identity is available.
CHATKIT_EXPERIMENTAL_ENABLED=false
OPENAI_API_KEY=REPLACE_ME
OPENAI_CHATKIT_WORKFLOW_ID=REPLACE_ME

VITE_ENABLE_EXPERIMENTAL_LAYOUT_CUSTOMIZATION=true

HOST=0.0.0.0
PORT=4010
FRONTEND_ORIGIN=http://127.0.0.1:4010
