# Preferred Garage Admin-specific Postgres connection. Falls back to DATABASE_URL if unset.
GARAGE_ADMIN_DATABASE_URL=postgresql://aibry:REPLACE_ME@fedora.local:5432/taskmaster
GARAGE_ADMIN_DATABASE_HOST=fedora.local
GARAGE_ADMIN_DATABASE_PORT=5432
GARAGE_ADMIN_DATABASE_CONNECT_TIMEOUT_MS=1500
GARAGE_ADMIN_DATABASE_QUERY_TIMEOUT_MS=2500
GARAGE_ADMIN_DATABASE_STATEMENT_TIMEOUT_MS=2500
GARAGE_ADMIN_DATABASE_IDLE_TIMEOUT_MS=10000
GARAGE_ADMIN_DATABASE_POOL_MAX=4
GARAGE_ADMIN_MEMORY_READ_TIMEOUT_MS=4500

# Backward-compatible fallback names.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=

ADMIN_BRIDGE_BASE_URL=http://fedora.local:4000
FEDORA_ADMIN_PROXY_URL=http://fedora.local:4000
FEDORA_GARAGE_API_URL=http://fedora.local:5000
FEDORA_GARAGE_API_KEY=REPLACE_ME
ADMIN_BRIDGE_TOKEN=REPLACE_ME
# Windows runtime bridge targets. Prefer loopback from this Windows-hosted app.
# Cloudflare Tunnel for windows-admin.aibry.shop should target 127.0.0.1:3105;
# unauthenticated /admin/health through that hostname should return 401.
WINDOWS_ADMIN_BASE_URL=http://127.0.0.1:3105
WINDOWS_ADMIN_AUTH_TOKEN=
# Windows Garage API is local-only and should stay on Waitress at 127.0.0.1:5100.
# Do not point this at Garage Admin V2 /api/windows-bridge routes.
WINDOWS_GARAGE_BASE_URL=http://127.0.0.1:5100
WINDOWS_GARAGE_LOOPBACK_BASE_URL=http://127.0.0.1:5100
WINDOWS_GARAGE_API_KEY=
WINDOWS_BRIDGE_TIMEOUT_MS=7000
ADMIN_BRIDGE_TIMEOUT_MS=10000
ADMIN_BRIDGE_ACTION_TIMEOUT_MS=30000
WINDOWS_EXECUTOR_TIMEOUT_MS=30000
WINDOWS_VERIFICATION_TIMEOUT_MS=5000

# Experimental ChatKit prep surface. Keep OPENAI_API_KEY server-side only.
# Hosted ChatKit sessions are created on the backend. The frontend receives only
# a short-lived client secret and uses a temporary local operator identifier until
# a durable authenticated operator identity is available.
CHATKIT_EXPERIMENTAL_ENABLED=false
OPENAI_API_KEY=REPLACE_ME
OPENAI_CHATKIT_WORKFLOW_ID=REPLACE_ME
CHATKIT_SESSION_TIMEOUT_MS=8000

# Server-only AIBRY Website contact inbox access. Never prefix these with VITE_.
AIBRY_WEBSITE_API_BASE_URL=https://aibry.shop
AIBRY_WEBSITE_INTERNAL_ADMIN_TOKEN=
AIBRY_WEBSITE_API_TIMEOUT_MS=8000

# Terminal SSH is intentionally disabled until a named server-side profile is implemented.
GARAGE_ADMIN_TERMINAL_SSH_ENABLED=false

VITE_ENABLE_EXPERIMENTAL_LAYOUT_CUSTOMIZATION=true

HOST=0.0.0.0
PORT=3010
FRONTEND_ORIGIN=http://127.0.0.1:3010
